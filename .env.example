# ─────────────────────────────────────────────
# FitSync — Environment Variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────

# MongoDB connection string.
# Local:  mongodb://localhost:27017/fitsync
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fitsync?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/fitsync

# Secret used to sign JWTs — use a long random string in production.
JWT_SECRET=change_this_to_a_long_random_secret

# How long a login token stays valid (e.g. 7d, 24h, 30m).
JWT_EXPIRE=7d

# Port the API server listens on.
PORT=5000

# development | production
NODE_ENV=development

# Public URL of the frontend. Used for CORS.
# Same-origin deploy:  http://localhost:5000
# Split deploy:        https://your-site.netlify.app
CLIENT_URL=http://localhost:5000
